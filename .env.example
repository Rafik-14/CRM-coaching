# Database
# Local dev: embedded Postgres started by `npm run db:server` (part of `npm run dev`). Production: postgres://user:pass@host:5432/db
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54320/postgres
# Local PGlite server handles one session at a time; use 10+ with real PostgreSQL
DATABASE_POOL_MAX=1

# Better Auth — generate a long random secret for each environment
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3100

# Coach account created by `npm run db:seed` on YOUR machine. Choose your own password (10+ characters).
# This is NOT the login of the online demo (Vercel): that one is in .env.vercel-demo (not committed).
SEED_COACH_EMAIL=coach@local.test
SEED_COACH_PASSWORD=choisissez-un-mot-de-passe
# Optional seed options:
# SEED_COACH_NAME=Jérémy Galéa
# SEED_DEMO_DATA=false   -> reference data only (stages, note templates, offers): real installation
# SEED_RESET_DEMO=true   -> wipe and re-create demo data (refused unless the business name contains « (démo) »)

# Email (Phase 2)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="CRM <no-reply@example.com>"

# Private file storage
FILES_DIR=./.data/files

# Public website: its address (canonical links, sitemap). Search engines are kept out automatically on Vercel
# (demo) or with SITE_NOINDEX=true.
NEXT_PUBLIC_SITE_URL=http://localhost:3100
# SITE_NOINDEX=true

# Website contact form → CRM (POST /api/formulaire-site)
# Comma-separated origins of the coach's website, e.g. https://www.example.com
SITE_FORM_ORIGINS=
# Optional: shared key if the website's server forwards the form (header x-form-key)
SITE_FORM_SECRET=
# Optional: where to send visitors after a plain HTML form submit
SITE_FORM_THANKS_URL=
