{
  "name": "coach-crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n db,web -c blue,green \"npm:db:server\" \"next dev --port 3100\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/server/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/server/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "db:reset": "node -e \"require('fs').rmSync('.data/pglite',{recursive:true,force:true})\" && concurrently -k -s first -n db,setup \"npm:db:server\" \"wait-on -t 30000 tcp:127.0.0.1:54320 && npm run db:migrate && npm run db:seed\"",
    "typecheck": "tsc --noEmit",
    "db:server": "node scripts/db-server.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.54.0",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.4",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@faker-js/faker": "^10.6.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "wait-on": "^9.5.1"
  }
}
